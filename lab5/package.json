{
  "name": "dogfight",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm test --workspaces --if-present",
    "bench": "npm run bench -w shared",
    "lint": "eslint client/src client/test server/src server/test server/tools shared/src shared/test shared/tools",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "vite": "^6.0.0"
  }
}
